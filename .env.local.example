# Copia este archivo a .env.local y completa con tus valores reales.
# .env.local esta gitignored: nunca se commitea.

# API key administrativa (RNF-11): las escrituras (POST/PUT/DELETE /api/productos)
# responden 503 sin ella (fail-closed). Debe ser la MISMA que VITE_ADMIN_API_KEY
# del frontend (pasteleria-my-dreams-react/.env.development).
APP_ADMIN_API_KEY=PEGA_AQUI_EL_MISMO_VALOR_DE_VITE_ADMIN_API_KEY
